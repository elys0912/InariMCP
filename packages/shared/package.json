  "private": true,
  "license": "MIT",
  "author": "elys0912",
  "homepage": "https://github.com/elys0912/InariMCP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elys0912/InariMCP.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/elys0912/InariMCP/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./action-names": {
      "types": "./dist/action-names.d.ts",
      "default": "./dist/action-names.js"
    },
    "./field-mask": {
      "types": "./dist/field-mask.d.ts",
      "default": "./dist/field-mask.js"
    },
    "./approval-site": {
      "types": "./dist/approval-site.d.ts",
      "default": "./dist/approval-site.js"
    },
    "./url-pattern-limit": {
      "types": "./dist/url-pattern-limit.d.ts",
      "default": "./dist/url-pattern-limit.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\""
  },
  "dependencies": {
    "zod": "^3.23.0"
  }
