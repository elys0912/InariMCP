    "directory": "packages/extension"
  },
  "bugs": {
    "url": "https://github.com/elys0912/KitsuneMCP/issues"
  },
  "scripts": {
    "build": "tsc -b && node -e \"const fs=require('fs'),p=require('path');[['src/popup/popup.html','dist/popup/popup.html'],['src/popup/popup.css','dist/popup/popup.css'],['src/content.css','dist/content.css']].forEach(([s,d])=>{fs.mkdirSync(p.dirname(d),{recursive:true});fs.copyFileSync(s,d)})\"",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\""
  }
}
