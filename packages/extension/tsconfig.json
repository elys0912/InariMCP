{
  // Type check only (`npm run typecheck`): the bundles in dist/ are built by
  // scripts/build-extension.mjs (esbuild), which does not look at types.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Every source file is a module (imports are resolved by the bundler).
    "moduleDetection": "force",
    // esbuild compiles one file at a time.
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // No @types/node: the Extension runs in Firefox only.
    "types": [],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src"]
}
