{
  "manifest_version": 2,
  "name": "KitsuneMCP",
  "version": "0.1.0",
  "description": "Firefox MCP addon for Claude Code — browser automation via extension + native messaging",
  "author": "KitsuneMCP Contributors",

  "permissions": [
    "activeTab",
    "tabs",
    "nativeMessaging",
    "notifications",
    "<all_urls>",
    "contextMenus",
    "contextualIdentities",
    "cookies",
    "find"
  ],

  "background": {
    "scripts": ["dist/action-map.js", "dist/background.js"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "css": ["dist/content.css"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],

  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "KitsuneMCP",
    "default_popup": "dist/popup/popup.html"
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "kitsune-mcp@example.com",
      "strict_min_version": "78.0"
    }
  },

  "web_accessible_resources": [
    "icons/*"
  ]
}
