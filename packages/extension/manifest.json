{
  "manifest_version": 2,
  "name": "KitsuneMCP",
  "version": "0.1.1",
  "description": "Firefox MCP addon for Claude Code — browser automation via extension + native messaging",
  "author": "elys0912",
  "homepage_url": "https://github.com/elys0912/KitsuneMCP",

  "permissions": [
    "activeTab",
    "tabs",
    "nativeMessaging",
    "notifications",
    "<all_urls>",
    "contextMenus",
    "contextualIdentities",
    "cookies",
    "find",
    "webNavigation"
  ],

  "background": {
    "scripts": ["dist/action-map.js", "dist/background.js"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "css": ["dist/content.css"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],

  "browser_action": {
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg"
    },
    "default_title": "KitsuneMCP",
    "default_popup": "dist/popup/popup.html"
  },

  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "kitsune-mcp@elys0912.github.io",
      "strict_min_version": "82.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "web_accessible_resources": [
    "icons/*"
  ]
}
