{
  "name": "kitsune-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Firefox MCP addon for Claude Code — browser automation via extension + native messaging",
  "license": "MIT",
  "author": "elys0912",
  "homepage": "https://github.com/elys0912/KitsuneMCP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elys0912/KitsuneMCP.git"
  },
  "bugs": {
    "url": "https://github.com/elys0912/KitsuneMCP/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "clean": "npm run clean --workspaces",
    "test": "vitest run --project=!e2e",
    "test:e2e": "vitest run --project=e2e",
    "test:firefox": "node scripts/test-firefox.mjs",
    "e2e:extension": "node scripts/e2e/extension-load.mjs",
    "lint:ext": "web-ext lint",
    "setup": "node scripts/install.mjs",
    "teardown": "node scripts/uninstall.mjs",
    "install:windows": "node scripts/install.mjs --build",
    "install:unix": "node scripts/install.mjs --build",
    "uninstall:windows": "node scripts/uninstall.mjs",
    "uninstall:unix": "node scripts/uninstall.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "web-ext": "^8.10.0"
  }
}
